# ==============================================================================
# REQUIRED CONFIGURATION
# ==============================================================================

# Anthropic Claude API Key — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="You can put your API key here"

# Standalone Agent Template Lock
OWNED_AGENT=veille
NEXT_PUBLIC_OWNED_AGENT=veille

# Apify API Token for live Instagram Reels scraping — https://console.apify.com/account/integrations
APIFY_TOKEN="You can put your API key here"

# ==============================================================================
# OPTIONAL INTEGRATIONS & MODEL SETTINGS
# ==============================================================================

# Google Gemini API Key for audio / video script transcription — https://aistudio.google.com/app/apikey
# GEMINI_API_KEY="You can put your API key here"  # Optional video script transcription

# Custom Claude Model Overrides
# ANTHROPIC_MODEL_SONNET=claude-sonnet-4-20250514
# ANTHROPIC_MODEL_OPUS=claude-opus-4-20250514

# Upgrade or multi-agent unlock URL (sales page or custom portal)
# NEXT_PUBLIC_UNLOCK_URL="You can put your API key here"
